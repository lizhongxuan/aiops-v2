          },
          "must_vars": [],
          "when": "",
          "loop": [],
          "retries": 0,
          "timeout": "30s",
          "continue_on_error": false,
          "expect_vars": [],
          "notify": []
        }
      }
    },
    {
      "op": "add_edge",
      "clientRef": "capacity_to_end",
      "edge": {
        "source": "capacity_check",
        "sourcePort": "next",
        "target": "end",
        "targetPort": "in",
        "kind": "next"
      }
    },
    {
      "op": "update_layout",
      "layout": {
        "nodes": [
          {
            "nodeId": "capacity_check",
