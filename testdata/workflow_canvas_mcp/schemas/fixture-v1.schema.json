{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aiops.local/schemas/workflow-canvas-fixture-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "fixtureId",
    "kind",
    "data"
  ],
  "properties": {
    "schemaVersion": {
      "const": "aiops.workflow-canvas.fixture/v1"
    },
    "fixtureId": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "workflow",
        "principal",
        "tenant",
        "grant",
        "revision",
        "failure-point"
      ]
    },
    "data": {
      "type": "object"
    }
  }
}
