+      await server.prompt({ sessionId: 'bridge-cancel', turnId: 'go-turn-cancel', contentBlocks: [{ type: 'text', text: 'read' }] })
+      await vi.waitFor(() => expect(transport.requests).toHaveLength(1))
+      await expect(server.cancel({ sessionId: 'bridge-cancel', turnId: 'wrong-turn' })).rejects.toThrow('does not match')
+      await expect(server.cancel({ sessionId: 'bridge-cancel', turnId: 'go-turn-cancel' })).resolves.toEqual({ accepted: true })
+      await ctx.agents.get(SessionId('bridge-cancel'))!.whenIdle()
