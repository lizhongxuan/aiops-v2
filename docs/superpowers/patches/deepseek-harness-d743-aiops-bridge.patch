+      })
+      await firstServer.wait({ sessionId: 'bridge-restart' })
+      const firstEvents = firstCtx.agents.get(SessionId('bridge-restart'))!.session.snapshotEvents()
+      firstSeqs = firstEvents.map(event => Number(event.seq))
+      expect(firstEvents.some(event => event.type === 'turn/end')).toBe(true)
+      await firstServer.shutdown()
