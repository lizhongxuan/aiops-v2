+    transport.requestHandler = (_method, _params, signal) => new Promise((_resolve, reject) => {
+      if (signal?.aborted) reject(new Error('aborted'))
+      else signal?.addEventListener('abort', () => reject(new Error('aborted')), { once: true })
+    })
+    ctx.llm.registerAdapter(['mock'], new MockAdapter([toolCallResponse('call-cancel', 'go_read', {})]))
