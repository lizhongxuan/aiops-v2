+    let firstSeqs: number[] = []
+    const bridgeParams = {
+      cwd: storageDir,
+      provider: 'mock',
+      model: 'mock',
+      aiopsBridgeVersion: 'aiops-dsh-bridge.v1',
+      aiopsTools: [{
+        name: 'go_read',
+        description: 'Read through Go.',
+        parameters: { type: 'object', properties: {}, additionalProperties: false },
+      }],
+    }
+    try {
